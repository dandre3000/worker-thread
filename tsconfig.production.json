{
    "extends":["./tsconfig.json"],
    "include": ["src/browser/index.ts", "src/server/index.ts"],
    "compilerOptions": {
        "noCheck": true,
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "allowImportingTsExtensions": true,
        "rootDir": ".",
        "outDir": "./build",
        "target": "es2025",
        "module": "esnext",
        "moduleResolution": "bundler"
    }
}